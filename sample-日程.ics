BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//win-island//sample//CN
CALSCALE:GREGORIAN
BEGIN:VEVENT
UID:sample-weekly-1
SUMMARY:每周例会（示例）
LOCATION:线上会议室
DESCRIPTION:这是合成样例，不是真实日程
DTSTART;TZID=Asia/Shanghai:20260927T100000
DTEND;TZID=Asia/Shanghai:20260927T110000
RRULE:FREQ=WEEKLY;BYDAY=SU;COUNT=8
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:提醒
TRIGGER:-PT30M
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:sample-class-2
SUMMARY:示例课程（示例）
LOCATION:东一301
DTSTART;TZID=Asia/Shanghai:20260928T183000
DTEND;TZID=Asia/Shanghai:20260928T200000
RRULE:FREQ=WEEKLY;BYDAY=MO,WE
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:提醒
TRIGGER:-PT15M
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:sample-allday-3
SUMMARY:毕设材料提交截止（示例全天）
DTSTART;VALUE=DATE:20260929
DTEND;VALUE=DATE:20260930
END:VEVENT
BEGIN:VEVENT
UID:sample-utc-4
SUMMARY:海外助教答疑（UTC 写法）
DTSTART:20260928T060000Z
DURATION:PT45M
END:VEVENT
BEGIN:VEVENT
UID:sample-broken-5
SUMMARY:时间写得乱七八糟的那条（示例：故意留的坏数据）
DTSTART:not-a-date
END:VEVENT
END:VCALENDAR
